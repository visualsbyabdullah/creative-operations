NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required server-side exact origin used for trusted invitation and recovery redirects.
# Use HTTPS outside local development; do not include a path, query, hash, or credentials.
APP_URL=https://app.example.com
AUTH_RECOVERY_STATE_SECRET=replace-with-at-least-32-random-characters
# Server-only administrative credential; never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Legacy fallback only when SUPABASE_SECRET_KEY is unavailable:
SUPABASE_SERVICE_ROLE_KEY=your-legacy-server-only-service-role-key
AUTH_SECURITY_HMAC_SECRET=replace-with-at-least-32-random-characters
