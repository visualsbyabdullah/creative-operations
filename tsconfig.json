{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@frontend/*": ["./frontend/src/*"],
      "@backend/*": ["./backend/src/*"],
      "@shared/*": ["./backend/src/shared/*"]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "backend/src/**/*.ts",
    "frontend/.next/types/**/*.ts",
    "frontend/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "code-bin"]
}
